---
import Base from '../layouts/Base.astro';
---
<Base title="Not here · Kaleb Jackson" description="This page isn't here.">
  <main class="wrap lost">
    <p class="label">404</p>
    <h1>Not made yet…</h1>
    <a class="tap" href="/">← Back to the web</a>
  </main>
</Base>

<style>
  .lost { min-height: 80svh; display: flex; flex-direction: column; justify-content: center; gap: 16px; }
  h1 { margin: 0; font: 800 clamp(48px, 9vw, 120px)/0.9 var(--display); letter-spacing: -0.04em; }
</style>
